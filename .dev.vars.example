# 本地开发用：复制为 .dev.vars 并填入真实值
# 生产环境需在 Cloudflare Pages 控制台 → Settings → Environment variables 中设置同名变量
#
# 注意：
# 1. ADMIN_AUTH_SECRET 为可选：不配置时后端自动回退到内置默认值（与
#    _p/index.html 中的 ADMIN_AUTH 常量一致），配置则须与该常量一致。
# 2. 若通过 GitHub 集成部署 Pages，wrangler.jsonc 中的 kv_namespaces 不会自动生效，
#    必须在 Pages 控制台 → Settings → Bindings → KV namespace 手动添加
#    变量名 VISITOR_STORE 指向对应的 KV 命名空间，否则访客监控与 KV 文章缓存不可用。
# 3. 在控制台添加变量/绑定后需重新部署一次才会对线上生效。
ADMIN_AUTH_SECRET=e0c8a441e60db2bad23db9f352b478c5

# 雫API 壁纸代理密钥（可选，缺失时前端自动回退本地壁纸）
SHIZUKU_API_KEY=

# 发布博文时自动推送 GitHub 的 Token（可选，也可在管理面板浏览器端填写）
GITHUB_TOKEN=

# ====== 评论系统 GitHub 登录（必填，否则评论区只能看不能登录） ======
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Homepage URL: https://omiasun.pages.dev
# Authorization callback URL: https://omiasun.pages.dev/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 管理员 GitHub 用户名（可选，逗号分隔；可删除任意评论）
COMMENT_ADMIN_USER=sunZshanY

# 原生账号密码的 pepper（建议设置一次后不要再改；改了旧密码会失效）
# 不设置时会回退到 ADMIN_AUTH_SECRET 或内置默认值
PASSWORD_PEPPER=

# 自定义域名时固定 OAuth 回调来源（可选，例如 https://blog.example.com）
PUBLIC_ORIGIN=

# ====== 评论数据库 D1 ======
# 先在 Cloudflare 创建 D1 并绑定 COMMENT_DB，然后执行：
# npx wrangler d1 execute omia-comments --remote --file=db/schema.d1.sql
# 本地开发：
# npx wrangler d1 execute COMMENT_DB --local --file=db/schema.d1.sql
# npx wrangler pages dev . --d1 COMMENT_DB
